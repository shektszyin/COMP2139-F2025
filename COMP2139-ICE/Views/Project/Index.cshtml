@* indicates that the view expects a list of Project objects as its model *@ 

@model List<Project>

@{ 

    ViewData["Title"] = "Projects"; 

} 

 
 

<h2>Projects</h2> 

<form asp-action="Search" method="get" class="mb-3">
    <input type="text" name="term" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search projects..." />
</form>


// Lab4 - Part5 - #1 

//"Create" 

<a asp-action="Create" class="btn btn-primary">Create New Project</a> <!--Lab4 - Part5 - #1 --> 

@if (Model.Any())   // to determine if there are any projects to display 

{ 

    <table class="table"> 

        <thead> 

        <tr> 

            <th>ID</th> 

            <th>Name</th> 

            <th>Description</th> 

            <th>Actions</th>

        </tr> 

        </thead> 

        <tbody> 

        <!-- A foreach loop is used to iterate over each Project in the model and display its properties in the table rows. --> 

        @foreach (var project in Model) 

        { 

            <tr> 

                <td>@project.ProjectId</td> 

                <td>@project.Name</td> 

                <td>@project.Description</td> 

                 

                <td><!--Lab4 - Part5 - #1 --> 

                              <!--"Details"-->    

                    <a asp-action="Details" asp-route-id="@project.ProjectId" class="btn btn-info">Details</a> 

                             <!--"Tasks"--> 
                    <a asp-controller="ProjectTask" asp-action="Index" asp-route-projectId="@project.ProjectId" class="btn btn-secondary">Tasks</a>

                               <!--Edit--> 
                    <a asp-action="Edit" asp-route-id="@project.ProjectId" class="btn btn-warning">Edit</a>
                                <!--"Delete"--> 
                    <a asp-action="Delete" asp-route-id="@project.ProjectId" class="btn btn-danger">Delete</a> 


                </td> 

            </tr> 

        } 

        </tbody> 

    </table> 

} 

else 

{ 

      if (ViewBag.Searched == true)
    {
        <p>No projects found for: <strong>@ViewBag.SearchTerm</strong></p>
    }
    else
    {
        <p>No projects available.</p>
    }

} 