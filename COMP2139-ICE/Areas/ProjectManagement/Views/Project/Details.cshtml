@model Project

@{
    ViewData["Title"] = "Project Details";
}

<h2>Project Details</h2>

<div class="card">
    <div class="card-body">

        <h3 class="card-title">
            @Html.DisplayFor(m => m.Name)
        </h3>

        <p class="card-text">
            @Html.DisplayFor(m => m.Description)
        </p>

        <dl class="row">
            <dt class="col-sm-3">Project ID</dt>
            <dd class="col-sm-9">@Model.ProjectId</dd>

            <dt class="col-sm-3">Start Date</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.StartDate)</dd>

            <dt class="col-sm-3">End Date</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.EndDate)</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.Status)</dd>
        </dl>

        <a asp-action="Edit" asp-route-id="@Model.ProjectId" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>


<hr />
<h3>Comments</h3>

<div id="commentSection"></div>

<textarea id="commentInput" class="form-control" placeholder="Add your comment..."></textarea>
<button id="addCommentBtn" class="btn btn-primary mt-2">Post Comment</button>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(function () {
            loadComments();
        });

        function loadComments() {
            $("#commentSection").load("/ProjectComment/LoadComments?projectId=@Model.ProjectId");
        }

        $("#addCommentBtn").click(function () {
            var content = $("#commentInput").val();

            $.ajax({
                url: "/ProjectComment/AddComment",
                type: "POST",
                data: {
                    projectId: @Model.ProjectId,
                    content: content
                },
                success: function (result) {
                    $("#commentSection").html(result);
                    $("#commentInput").val("");
                }
            });
        });
    </script>
}

}
