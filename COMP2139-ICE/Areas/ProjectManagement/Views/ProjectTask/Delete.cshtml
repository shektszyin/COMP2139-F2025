@model ProjectTask

@{
    ViewData["Title"] = "Delete Task";
}

<h2>Delete Task</h2>

<h4>Are you sure you want to delete this task?</h4>
<hr />

<dl class="row">

    <dt class="col-sm-2">
        @Html.DisplayNameFor(m => m.Title)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(m => m.Title)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(m => m.Description)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(m => m.Description)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(m => m.DueDate)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(m => m.DueDate)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(m => m.IsCompleted)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(m => m.IsCompleted)
    </dd>
    
</dl>

<form asp-action="DeleteConfirmed" asp-route-id="@Model.ProjectTaskId" method="post">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ProjectTaskId)
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-controller="Project" asp-action="Details" asp-route-id="@Model.ProjectId" class="btn btn-secondary">Back to Project</a>
</form>
